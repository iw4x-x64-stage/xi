intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

windows = ($cxx.target.class == 'windows')

# MinHook hooks functions with the Win32 API, so we only import it on
# Windows.
#
if $windows
  import impl_libs += libminhook%lib{minhook}

lib{xi}: {hxx ixx txx cxx}{** -config -version -win32/**} hxx{config version}

# The hooks of the Win32 functions only exist on Windows. Note that they go
# before the libraries, so that the linker sees MinHook after the objects
# that use it.
#
lib{xi}: win32/{hxx cxx}{**}: include = $windows

lib{xi}: $impl_libs $intf_libs

hxx{config}: in{config}
hxx{version}: in{version} $src_root/manifest

# Build options.
#
cxx.poptions =+ "-I$out_root" "-I$src_root"

obja{*}: cxx.poptions += -DLIBXI_STATIC_BUILD
objs{*}: cxx.poptions += -DLIBXI_SHARED_BUILD

# Export options.
#
lib{xi}:
{
  cxx.export.poptions = "-I$out_root" "-I$src_root"
  cxx.export.libs = $intf_libs
}

liba{xi}: cxx.export.poptions += -DLIBXI_STATIC
libs{xi}: cxx.export.poptions += -DLIBXI_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{xi}: bin.lib.version = "-$version.project_id"
else
  lib{xi}: bin.lib.version = "-$version.major.$version.minor"

# Install into the libxi/ subdirectory of, say, /usr/include/
# recreating subdirectories.
#
{hxx ixx txx}{*}:
{
  install         = include/libxi/
  install.subdirs = true
}

# The hooks are private to the library.
#
win32/hxx{*}: install = false
